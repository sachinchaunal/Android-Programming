<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NineActivity">

    <TextView
        android:id="@+id/textView9"
        android:layout_width="226dp"
        android:layout_height="51dp"
        android:text="Toggle Button"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/togglebtnxml"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.448"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="375dp"
        android:layout_height="78dp"
        android:text="AutoCompleteEditTextView"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/actxml"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/togglebtnxml"
        app:layout_constraintVertical_bias="0.5" />

    <ToggleButton
        android:id="@+id/togglebtnxml"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:text="ToggleButton"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/textView10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9"
        app:layout_constraintVertical_bias="0.5" />

    <AutoCompleteTextView
        android:id="@+id/actxml"
        android:layout_width="329dp"
        android:layout_height="48dp"
        android:hint="AutoCompleteTextView"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.531" />

    <Button
        android:id="@+id/button21"
        android:layout_width="132dp"
        android:layout_height="53dp"
        android:onClick="closePage"
        android:text="Back"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.229"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actxml"
        app:layout_constraintVertical_bias="0.861" />

    <Button
        android:id="@+id/button24"
        android:layout_width="144dp"
        android:layout_height="54dp"
        android:onClick="nextpage"
        android:text="Next"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.793"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.945" />
</androidx.constraintlayout.widget.ConstraintLayout>